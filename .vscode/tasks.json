{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake configure (debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "debug"
            ]
        },
        {
            "label": "CMake build (debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake configure + build (debug)",
            "dependsOn": [
                "CMake configure (debug)",
                "CMake build (debug)"
            ]
        }
    ]
}