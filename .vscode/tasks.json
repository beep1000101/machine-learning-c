{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build active C file (debug)",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "-O0",
                "-Wall",
                "-Wextra",
                "-I${workspaceFolder}/src/c/include",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}_dbg"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}