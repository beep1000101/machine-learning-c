{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build active C file only (debug)",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "-O0",
                "-Wall",
                "-Wextra",
                "-I${workspaceFolder}/src/c/include",
                "${file}",
                "${workspaceFolder}/src/c/algebra/vector.c",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}_dbg",
                "-lm"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake configure (debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "debug"
            ]
        },
        {
            "label": "CMake build (debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake configure + build (debug)",
            "dependsOn": [
                "CMake configure (debug)",
                "CMake build (debug)"
            ]
        }
    ]
}