{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Active C File (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}_dbg",
            "cwd": "${fileDirname}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build active C file (debug)",
            "stopAtEntry": false,
            "externalConsole": false
        }
    ]
}